# Conexión a Postgres (Supabase: Project Settings → Database → Connection string → Transaction pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Conexiones simultáneas del pool (1 para la base local de prueba, 3-5 en producción)
DB_POOL_MAX=3
# Clave para firmar la sesión del login (cualquier texto largo y aleatorio)
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio
